---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const links = [
  { href: '/how-it-works', title: 'How it works', text: 'See how MoneyOS runs under every Aryze product.' },
  {
    href: '/company#trust',
    title: 'Review trust and regulation',
    text: 'See who is responsible for what, and what the evidence shows.',
  },
  {
    href: '/contact',
    title: 'Talk to Aryze',
    text: 'Contact the Copenhagen team about your money flow or due-diligence questions.',
  },
];
---

<Base
  title="Page not found — Aryze"
  description="The requested page could not be found. Explore Aryze or contact the Copenhagen team."
>
  <PageHero
    eyebrow="404"
    title="This page isn't here."
    lede="The address may have changed, or the page may no longer exist. How Aryze works, trust information and the Aryze team are still one click away."
  />
  <section class="section">
    <div class="container grid grid--3">
      {
        links.map((l) => (
          <a href={l.href} class="card">
            <h2>{l.title}</h2>
            <p>{l.text}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .card h2 {
    letter-spacing: -0.01em;
    margin: 0 0 8px;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }
</style>
