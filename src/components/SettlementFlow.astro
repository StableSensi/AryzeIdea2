---
/**
 * Illustrative GBP ⇄ EUR conversion widget (<aryze-settlement-flow>), used in
 * the platform page's MoneyOS orchestration panel.
 *
 * The visitor picks a direction and enters an amount; the button plays a
 * "<FROM> burned → Recorded → <TO> minted" animation that drains the source amount into the
 * destination at a fixed example rate. Nothing is transacted. Controls are
 * rendered disabled and enabled by the custom element once JS runs.
 *
 * Props:
 *   rate    example GBP→EUR rate (default 1.18)
 *   amount  initial amount text (default "1,000")
 */
interface Props {
  rate?: number;
  amount?: string;
}
const { rate = 1.18, amount = '1,000' } = Astro.props;
---

<aryze-settlement-flow
  class="settlement-flow ready"
  data-rate={String(rate)}
  role="group"
  aria-label="Illustrative currency conversion, not live activity"
>
  <div class="selector">
    <div class="side side--from">
      <label class="currency"
        ><span class="flag from-flag" aria-hidden="true">🇬🇧</span><select disabled class="from" aria-label="From currency"
          ><option>GBP</option><option>EUR</option></select
        ><svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg></label
      ><label class="amount-line"
        ><span class="sym from-sym" aria-hidden="true">£</span><span class="amount-wrap"
          ><input
            disabled
            class="amount"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            value={amount}
            aria-label="Amount to convert"
          /><output class="drain" aria-label="Remaining amount" aria-live="off" hidden></output></span
        ></label
      >
    </div>
    <button disabled class="forge" aria-label="Play the conversion" title="Play: GBP burned, recorded, EUR minted"
      ><svg class="flow" viewBox="0 0 140 54" aria-hidden="true"
        ><g class="source"
          ><circle
            class="source-ring"
            cx="20"
            cy="27"
            r="13"
            pathLength="1"
            fill="none"
            stroke="#007599"
            stroke-width="1.4"></circle><text
            class="source-symbol"
            x="20"
            y="32"
            text-anchor="middle"
            font-size="16"
            font-weight="400"
            fill="#001e2b">£</text
          ></g
        ><g class="flame"
          ><circle cx="70" cy="27" r="19" fill="white" stroke="#e5ebee"></circle><path
            class="fire"
            d="M71 16c1 5-5 7-5 11-1-1-2-2-2-3-4 6-2 13 6 14 8 0 11-7 7-13-1 3-2 3-2 3 1-5-1-9-4-12Z"
            fill="none"
            stroke="#007599"
            stroke-width="1.4"
            stroke-linejoin="round"></path></g
        ><g class="destination"
          ><circle
            class="destination-ring"
            cx="120"
            cy="27"
            r="13"
            pathLength="1"
            fill="none"
            stroke="#007599"
            stroke-width="1.4"></circle><text
            class="destination-symbol"
            x="120"
            y="32"
            text-anchor="middle"
            font-size="16"
            font-weight="400"
            fill="#001e2b">€</text
          ></g
        ></svg
      ></button
    >
    <div class="side side--to">
      <label class="currency"
        ><span class="flag to-flag" aria-hidden="true">🇪🇺</span><select disabled class="to" aria-label="To currency"
          ><option>EUR</option><option>GBP</option></select
        ><svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg></label
      >
      <p class="amount-line amount-line--out">
        <span class="sym to-sym" aria-hidden="true">€</span><output
          class="result empty"
          aria-label="Converted amount"
          aria-live="off">—</output
        >
      </p>
    </div>
  </div>
  <p class="amount-error" role="alert" hidden></p>
  <p class="edit-line" hidden><button disabled type="button" class="edit-amount">Edit amount</button></p>
  <p class="hint">
    <span class="phase"
      ><span data-stage="0">GBP burned</span> → <span data-stage="1">Recorded</span> → <span data-stage="2">EUR minted</span></span
    >
  </p>
  <p class="rate">Example rate: <span class="rate-text">£1 = €{rate.toFixed(2)}</span>. Not a quote.</p>
  <p class="sr-only status" aria-live="polite"></p>
</aryze-settlement-flow>

<script>
  import '../scripts/settlement-flow';
</script>

<style>
  .settlement-flow {
    width: 100%;
    max-width: 650px;
    font-family: var(--font);
    color: #13252d;
    margin-inline: auto;
    display: block;
    container-type: inline-size;
  }
  .settlement-flow {
    box-sizing: border-box;
  }
  .settlement-flow [hidden] {
    display: none !important;
  }
  .forge:disabled,
  .currency select:disabled,
  .amount:disabled {
    opacity: 1;
    cursor: default;
  }
  .selector {
    background: #fff;
    border: 1px solid #e5e7e7;
    border-radius: 16px;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 22px 30px;
    display: grid;
    box-shadow: 0 2px 4px #001e2b04;
  }
  .side {
    gap: 10px;
    min-width: 0;
    display: grid;
  }
  .side--to {
    text-align: right;
    justify-items: end;
  }
  .currency {
    align-items: center;
    gap: 8px;
    width: max-content;
    display: flex;
    position: relative;
  }
  .flag {
    font-size: 27px;
    line-height: 1;
  }
  .currency select {
    color: #111b21;
    appearance: none;
    cursor: pointer;
    background: 0 0;
    border: 0;
    border-radius: 5px;
    padding: 6px 23px 6px 0;
    font:
      500 21px Geist Variable,
      sans-serif;
  }
  .chevron {
    pointer-events: none;
    fill: none;
    stroke: #afb6b8;
    stroke-width: 2px;
    width: 14px;
    height: 14px;
    position: absolute;
    right: 0;
  }
  .amount-line {
    letter-spacing: -0.02em;
    color: #001e2b;
    font-variant-numeric: tabular-nums;
    align-items: baseline;
    gap: 4px;
    min-width: 0;
    margin: 0;
    font:
      400 26px/1.2 Geist Variable,
      sans-serif;
    display: flex;
  }
  .amount-line--out {
    justify-content: flex-end;
  }
  .sym {
    color: #647b84;
  }
  .amount-wrap {
    flex: auto;
    min-width: 0;
    max-width: 7.5em;
    display: block;
    position: relative;
  }
  .amount {
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    font-variant-numeric: tabular-nums;
    background: 0 0;
    border: 0;
    border-bottom: 1.5px solid #cfe3ee;
    border-radius: 0;
    width: 100%;
    min-width: 0;
    padding: 2px 0;
  }
  .amount:hover {
    border-bottom-color: #9cc9dd;
  }
  .amount:focus {
    border-bottom-color: #007599;
    outline: none;
  }
  .amount:focus-visible {
    outline: 2px solid #007599;
    outline-offset: 4px;
  }
  .drain {
    white-space: nowrap;
    pointer-events: none;
    color: #001e2b;
    font-variant-numeric: tabular-nums;
    padding: 2px 0;
    transition: color 0.4s;
    display: block;
  }
  .draining .drain {
    color: #c47643;
  }
  .drained .drain {
    color: #647b84;
  }
  .result {
    white-space: nowrap;
    transition:
      opacity 0.3s,
      color 0.3s;
  }
  .result.stale {
    opacity: 0.3;
  }
  .result.empty {
    color: #b9c6cb;
  }
  .result.counting {
    color: #007599;
  }
  .currency select:focus-visible,
  .edit-amount:focus-visible,
  .forge:focus-visible {
    outline-offset: 5px;
    outline: 2px solid #007599;
  }
  .forge {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    background: 0 0;
    border: 0;
    border-radius: 24px;
    flex-shrink: 0;
    place-items: center;
    width: 140px;
    height: 54px;
    padding: 0;
    display: grid;
  }
  .flow {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .source-ring,
  .destination-ring {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transform-box: fill-box;
    transform-origin: 50%;
    transform: rotate(-90deg);
  }
  .amount-error {
    color: #9b3819;
    text-align: center;
    margin: 10px 0 0;
    font-size: 12px;
    line-height: 1.5;
  }
  .edit-line {
    text-align: center;
    margin: 10px 0 0;
  }
  .edit-amount {
    color: #007599;
    font: inherit;
    cursor: pointer;
    text-underline-offset: 3px;
    background: 0 0;
    border: 0;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 12px;
    text-decoration: underline;
  }
  .large-amount .amount-line {
    font-size: 20px;
  }
  .hint {
    text-align: center;
    letter-spacing: 0.015em;
    color: var(--muted);
    min-height: 18px;
    margin: 18px 0 0;
    font-size: 12px;
    line-height: 18px;
  }
  .rate {
    text-align: center;
    color: var(--muted);
    margin: 6px 0 0;
    font-size: 12px;
  }
  .phase[data-active="0"] [data-stage="0"],
  .phase[data-active="1"] [data-stage="1"],
  .phase[data-active="2"] [data-stage="2"] {
    color: #007599;
    font-weight: 650;
  }
  .sr-only {
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    position: absolute;
    overflow: hidden;
  }
  .running .source {
    animation: 5.4s cubic-bezier(0.4, 0, 0.2, 1) both source-travel;
  }
  .running .source-ring {
    animation: 5.4s linear both source-issue;
  }
  .running .source-symbol {
    animation: 5.4s linear both source-mark;
  }
  .running .destination-ring {
    animation: 5.4s linear both destination-issue;
  }
  .running .destination-symbol {
    animation: 5.4s linear both destination-mark;
  }
  .running .fire {
    animation: 5.4s linear both burn;
  }
  .complete .source {
    opacity: 0;
  }
  @keyframes source-issue {
    0% {
      stroke-dashoffset: 1px;
    }
    20%,
    34% {
      stroke-dashoffset: 0;
    }
    52%,
    to {
      stroke-dashoffset: 1px;
    }
  }
  @keyframes source-mark {
    0%,
    10% {
      opacity: 0;
    }
    20%,
    33% {
      opacity: 1;
    }
    48%,
    to {
      opacity: 0;
    }
  }
  @keyframes source-travel {
    0%,
    31% {
      opacity: 1;
      transform: translate(0);
    }
    51% {
      opacity: 0;
      transform: translate(30px);
    }
    to {
      opacity: 0;
      transform: translate(30px);
    }
  }
  @keyframes burn {
    0%,
    31%,
    58%,
    to {
      stroke: #007599;
      fill: #0000;
    }
    43%,
    48% {
      stroke: #c47643;
      fill: #f5e4d9;
    }
  }
  @keyframes destination-issue {
    0%,
    61% {
      stroke-dashoffset: 1px;
    }
    83%,
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes destination-mark {
    0%,
    76% {
      opacity: 0;
    }
    90%,
    to {
      opacity: 1;
    }
  }
  @container (width<=520px) {
    .selector {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 18px;
    }
    .side {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 14px;
    }
    .side--to {
      text-align: left;
      justify-items: stretch;
    }
    .amount-line {
      text-align: right;
      justify-content: flex-end;
      font-size: 22px;
    }
    .large-amount .amount-line {
      font-size: 18px;
    }
    .amount-wrap {
      max-width: none;
    }
    .amount,
    .drain {
      text-align: right;
    }
    .forge {
      justify-self: center;
      width: 120px;
      height: 46px;
    }
    .flag {
      font-size: 22px;
    }
    .currency select {
      padding-right: 17px;
      font-size: 17px;
    }
    .chevron {
      width: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .running .source,
    .running .source-ring,
    .running .source-symbol,
    .running .destination-ring,
    .running .destination-symbol,
    .running .fire {
      animation: none;
    }
    .result {
      transition: none;
    }
  }
</style>
